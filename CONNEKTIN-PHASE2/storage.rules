rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/photo.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /articles/covers/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    // College logos, uploaded from the Colleges admin tab. Same shape as
    // articles/covers above (auth + size + type, no cross-service Firestore
    // role check — that's what was actually failing here; the app already
    // gates the Admin UI client-side the same way it does for companies).
    match /colleges/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
